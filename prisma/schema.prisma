generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  shops        Shop[]
}

model Plan {
  id         String   @id @default(cuid())
  name       String
  priceCents Int
  interval   String   @default("month")
  features   String
  sortOrder  Int      @default(0)
  shops      Shop[]
}

model Shop {
  id           String    @id @default(cuid())
  ownerId      String    @unique
  owner        User      @relation(fields: [ownerId], references: [id])
  name         String
  slug         String    @unique
  tagline      String?
  logoUrl      String?
  primaryColor String    @default("#111827")
  currency          String    @default("AED")
  fulfillmentMode   String    @default("PICKUP")
  shippingFeeCents  Int       @default(0)
  shippingPolicy    String?
  returnPolicy      String?
  stripeAccountId       String?   @unique
  stripeChargesEnabled  Boolean   @default(false)
  stripePayoutsEnabled  Boolean   @default(false)
  published    Boolean   @default(false)
  publishedAt  DateTime?
  planId       String?
  plan         Plan?     @relation(fields: [planId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  pages        Page[]
  products     Product[]
  orders       Order[]
}

model Page {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  slug      String   @default("home")
  title     String   @default("Home")
  layout    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, slug])
}

model Product {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priceCents  Int
  imageUrl    String?
  imageFocalX Int      @default(50)
  imageFocalY Int      @default(50)
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  shopId          String
  shop            Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  stripeSessionId String?     @unique
  stripeAccountId String?
  customerEmail   String?
  shippingName    String?
  shippingAddress String?
  status          String      @default("pending")
  currency        String      @default("AED")
  fulfillmentMode String      @default("DELIVERY")
  shippingFeeCents Int         @default(0)
  fulfillmentStatus String     @default("UNFULFILLED")
  fulfilledAt      DateTime?
  totalCents      Int
  reservedAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  @@index([status, expiresAt])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  title      String
  priceCents Int
  quantity   Int
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}
